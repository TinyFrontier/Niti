# Public application hosts. Point app, api and traefik DNS records to the VPS.
# The apex useniti.xyz is served separately by the public landing.
APP_HOST=app.useniti.xyz
API_HOST=api.useniti.xyz
TRAEFIK_HOST=traefik.useniti.xyz
LETSENCRYPT_EMAIL=ops@useniti.xyz
DOCKER_NETWORK_NAME=niti

# Shared parent-domain cookie keeps existing sessions valid across the app/API
# split. Set this to an empty value only when switching to API host-only cookies.
COOKIE_DOMAIN=.useniti.xyz

# Replace every CHANGE_ME value before a production deployment.
POSTGRES_DB=niti
POSTGRES_USER=niti
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
DATABASE_URL=postgresql+psycopg://niti:CHANGE_ME_POSTGRES_PASSWORD@postgres:5432/niti
POSTGRES_PORT=5432
SECRET_KEY=CHANGE_ME_LONG_RANDOM_SECRET

BACKEND_WORKERS=2

# Google OAuth credentials (https://console.cloud.google.com/apis/credentials).
# Leave empty to disable Google sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# AI provider. One OpenRouter key covers every model; AI_MODEL takes an OpenRouter
# model slug (https://openrouter.ai/models), so switching models needs no code change.
# Leave the key empty to disable AI features.
OPEN_ROUTER_API_KEY=
AI_MODEL=bytedance-seed/seed-1.6-flash
# Matching is measured separately; empty falls back to AI_MODEL.
AI_MODEL_MATCH=google/gemini-2.5-flash-lite

# Example login is admin / change-me. Generate a replacement with:
# htpasswd -nbB admin 'your-password'
# Keep this value single-quoted so Compose treats the $ characters literally.
TRAEFIK_DASHBOARD_AUTH_USERS='admin:$2y$05$fp4S6KUtP8vmR/ZK.etVSebXcaQl9hAmL/ueBtjPURzPj2RG.7Swe'
