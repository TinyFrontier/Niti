DATABASE_URL=postgresql+psycopg://jobsearch:jobsearch@localhost:5432/jobsearch
SECRET_KEY=dev-secret-change-me
CORS_ORIGINS=["http://localhost:5173"]
UPLOAD_DIR=uploads

# Google OAuth (leave empty to disable Google sign-in)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

API_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
# COOKIE_DOMAIN unset -> host-only cookie (dev default)
COOKIE_SECURE=false
SESSION_EXPIRE_DAYS=30
DEBUG=true

# AI provider. AI_MODEL is an OpenRouter model slug (https://openrouter.ai/models),
# so switching models needs no code change. Empty key disables AI features.
OPEN_ROUTER_API_KEY=
AI_MODEL=google/gemini-2.5-flash-lite
AI_TIMEOUT_SECONDS=30
AI_MAX_INPUT_CHARS=40000
